# Copy this file to .env for local development (never commit .env).
# On your host (Render, Railway…), add the same values in its Environment settings.

# From resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Where contact messages are delivered
CONTACT_TO_EMAIL=you@gmail.com

# Sites allowed to call this backend, comma-separated, no trailing slash
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com,https://www.yourdomain.com

# After verifying your domain in Resend:
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>
# SEND_AUTO_REPLY=true

# Most hosts set PORT for you; 3001 is used locally
# PORT=3001
